{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "졸업요건 플래너",
  "version": "0.1.0",
  "identifier": "com.yonsei.graduation-planner",
  "build": {
    "beforeDevCommand": "pnpm desktop:dev",
    "beforeBuildCommand": "pnpm desktop:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "title": "졸업요건 플래너",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
